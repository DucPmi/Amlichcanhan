<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Hàng trên: Giờ real-time + Ngày Dương/Âm + Nút làm mới -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextClock
            android:id="@+id/widget_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:timeZone="Asia/Ho_Chi_Minh"
            android:textColor="#F8FAFC"
            android:textSize="32sp"
            android:fontFamily="sans-serif-light" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_solar_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chủ Nhật, 22/11/2026"
                android:textColor="#F8FAFC"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_lunar_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ÂL: Ngày 14 tháng 10 • Bính Ngọ"
                android:textColor="#FDE68A"
                android:textSize="11.5sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_refresh_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_bg"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="↻"
            android:textColor="#F8FAFC"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="8dp"
        android:src="@drawable/widget_divider"
        android:contentDescription="@null" />

    <!-- Lịch sắp tới gần nhất -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_next_event_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_bg"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="Sắp tới"
            android:textColor="#7DD3FC"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_next_event"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Chưa có sự kiện sắp tới"
            android:textColor="#E2E8F0"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- English Daily Quote -->
    <TextView
        android:id="@+id/widget_quote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="“Clarity precedes mastery.” — Robin Sharma"
        android:textColor="#E2E8F0"
        android:textSize="11.5sp"
        android:textStyle="italic"
        android:maxLines="2"
        android:ellipsize="end" />
</LinearLayout>
